# Configuration is supplied as environment variables; this file is not loaded automatically.
# The default engine is offline. Enable OpenAI explicitly with WORK_ASSISTANT_ENGINE=openai.
OPENAI_API_KEY="" # configure locally
WORK_ASSISTANT_ENGINE=offline
WORK_ASSISTANT_DB=data/officebot.sqlite
WORK_ASSISTANT_SCHEDULER_ENABLED=0
# Optional Discord runtime; all identifiers and a bot token must be configured.
WORK_ASSISTANT_DISCORD_OWNER_ID="" # configure locally
WORK_ASSISTANT_DISCORD_GUILD_ID="" # configure locally
WORK_ASSISTANT_DISCORD_CHANNEL_ID="" # configure locally
DISCORD_BOT_ID="" # configure locally
DISCORD_BOT_TOKEN="" # configure locally
# Use the same independently generated value (at least 32 characters) on both processes.
WORK_ASSISTANT_DISCORD_BRIDGE_TOKEN="" # configure locally
WORK_ASSISTANT_DISCORD_NOTIFICATIONS=0
# Startup catch-up is disabled unless explicitly set to 1.
WORK_ASSISTANT_DISCORD_CATCHUP=0
